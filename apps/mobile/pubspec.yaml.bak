name: ironlog
description: "IronLog - workout, weight and measurement tracker."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.12.2

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8
  provider: ^6.1.2
  http: ^1.2.2
  intl: ^0.19.0
  firebase_core: ^3.8.1
  firebase_auth: ^5.3.4
  fl_chart: ^0.69.0
  google_fonts: ^8.2.0
  shared_preferences: ^2.5.5
  sensors_plus: ^6.1.1
  flutter_foreground_task: ^10.0.0
  cloud_firestore: ^5.6.12
  flutter_colorpicker: ^1.1.0
  permission_handler: ^12.0.3
  csv: ^8.0.0
  file_picker: ^3.0.4
  share_plus: ^13.3.0
dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0

flutter:
  uses-material-design: true
  assets:
    - assets/data/exercises.json
